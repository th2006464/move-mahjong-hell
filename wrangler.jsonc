{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "move-mahjong-hell",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sum-ten-game-data",
      "database_id": "30c8ccef-3cbb-4659-9298-9be05b39c15a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "move-mahjong-hell.game.foxtang.com",
      "custom_domain": true
    }
  ]
}
