{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sum-ten-game-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "sum-ten-game.game.foxtang.com",
      "custom_domain": true
    }
  ]
}
